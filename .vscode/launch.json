    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug expenses with CSV stdin",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_expenses.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "Sales",
                "2021",
                "--expense_type",
                "software"
